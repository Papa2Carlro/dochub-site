# Free ship (Cloudflare Pages *.pages.dev) — copy to site/.env for local / CI builds
VITE_SITE_URL=https://dochub-site.pages.dev
# Tracked CDN (Cloudflare Worker). After `wrangler deploy` in dochub-downloads-worker, set to the workers.dev URL.
# VITE_DOWNLOADS_BASE=https://dochub-downloads.<account-subdomain>.workers.dev
# Until Worker URL is known, leave unset — Download buttons fall back to GitHub Releases / VITE_DIST_REPO.
# VITE_DIST_REPO=Papa2Carlro/doc-hub-releases
# Custom domain later:
# VITE_SITE_URL=https://doc-hub.app
# VITE_DOWNLOADS_BASE=https://downloads.doc-hub.app
# Page analytics — Cloudflare Web Analytics (preferred on Pages)
# VITE_CF_BEACON_TOKEN=…   # from dash → Analytics → Web Analytics → site token
# Optional Plausible:
# VITE_PLAUSIBLE_DOMAIN=doc-hub.app
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Waitlist email capture (Formspree form id)
# VITE_FORMSPREE_ID=
