# Optional — copy to site/.env for local / CI builds
VITE_SITE_URL=https://doc-hub.app
# Tracked CDN (Cloudflare Worker). When set, Download buttons use /d/{mac|win|linux}.
VITE_DOWNLOADS_BASE=https://downloads.doc-hub.app
# Fallback mirror only if CDN unset:
# VITE_DIST_REPO=Papa2Carlro/doc-hub-releases
# Page analytics (Plausible) — separate from download counters
# VITE_PLAUSIBLE_DOMAIN=doc-hub.app
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Waitlist email capture (Formspree form id, no custom backend)
# VITE_FORMSPREE_ID=
