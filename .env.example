# Free ship (Cloudflare Pages *.pages.dev) — copy to .env for local builds
VITE_SITE_URL=https://dochub-site.pages.dev
# Tracked CDN (Cloudflare Worker) — keep set so Download CTAs hit KV counters
VITE_DOWNLOADS_BASE=https://dochub-downloads.dochubhq.workers.dev
# VITE_DIST_REPO=Papa2Carlro/dochub-releases

# —— Page analytics (all optional) ——
# Prefer Cloudflare Web Analytics on Pages (also powers local admin visits):
# VITE_CF_BEACON_TOKEN=
# Optional Plausible:
# VITE_PLAUSIBLE_DOMAIN=dochub-site.pages.dev
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Optional Google Analytics 4 (cookies — see /privacy/):
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXX
# Optional Google Search Console HTML-tag verification:
# VITE_GOOGLE_SITE_VERIFICATION=

# Waitlist email capture (Formspree form id)
# VITE_FORMSPREE_ID=

# Custom domain later (flip when DNS is live):
# VITE_SITE_URL=https://doc-hub.app
# VITE_DOWNLOADS_BASE=https://downloads.doc-hub.app
# VITE_PLAUSIBLE_DOMAIN=doc-hub.app
